---
import "swiper/css";
import "swiper/css/navigation";
import "swiper/css/pagination";
import { withBase } from "../lib/url";

interface Slide {
    title: string;
    image: string;
}

interface Props {
    galleryId: string;
    label: string;
    slides: Slide[];
}

const { galleryId, label, slides } = Astro.props;
---

<div class="swiper carousel" aria-label={label}>
    <div class="swiper-wrapper">
        {slides.map((slide, index) => (
            <a class="swiper-slide glightbox" href={withBase(slide.image)} data-gallery={galleryId} data-title={slide.title}>
                <img
                    src={withBase(slide.image)}
                    alt={slide.title}
                    width="1280"
                    height="720"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                />
            </a>
        ))}
    </div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-next"></div>
</div>

<script>
    import GLightbox from "glightbox";
    import "glightbox/dist/css/glightbox.min.css";
    import Swiper from "swiper";
    import { Autoplay, Keyboard, Navigation, Pagination } from "swiper/modules";

    document.querySelectorAll<HTMLElement>(".carousel").forEach(
        (carousel) =>
            new Swiper(carousel, {
                modules: [Autoplay, Keyboard, Navigation, Pagination],
                loop: true,
                autoplay: { delay: 4000, pauseOnMouseEnter: true },
                keyboard: { onlyInViewport: true },
                navigation: {
                    prevEl: carousel.querySelector<HTMLElement>(".swiper-button-prev"),
                    nextEl: carousel.querySelector<HTMLElement>(".swiper-button-next"),
                },
                pagination: { el: carousel.querySelector<HTMLElement>(".swiper-pagination"), type: "fraction" },
            }),
    );

    GLightbox({ selector: ".glightbox" });
</script>

<style>
    .carousel {
        --swiper-navigation-color: var(--bg);
        --swiper-navigation-size: 1.4rem;
        --swiper-navigation-sides-offset: 0.6rem;
        --swiper-navigation-top-offset: calc(100% - 1rem);
        --swiper-pagination-color: var(--bg);
        --swiper-pagination-fraction-color: var(--bg);
        --swiper-pagination-bottom: 0.15rem;

        padding-bottom: 2rem;
        border: 4px solid var(--cyan);
        border-radius: 10px;
        background: linear-gradient(to top, var(--cyan) 2rem, black 2rem);
        font-family: var(--font-body);
        font-weight: 600;
    }

    .carousel img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
    }
</style>
