---
import "swiper/css";
import "swiper/css/effect-creative";
import "swiper/css/navigation";
import "swiper/css/pagination";
import type { ThumbnailCard } from "../lib/thumbnail-card";

interface Props {
    tierIndex: number;
    label: string;
    slides: ThumbnailCard[];
}

const { tierIndex, label, slides } = Astro.props;
---

<div class="carousel-frame glow-card" data-carousel-frame>
    <img class="carousel-glow" data-carousel-glow src={slides[0]?.image} alt="" aria-hidden="true" />
    <div class="swiper carousel" aria-label={label}>
        <div class="swiper-wrapper">
            {slides.map((slide, index) => (
                <button
                    class="swiper-slide"
                    type="button"
                    data-thumbnail-tier={tierIndex}
                    data-thumbnail-index={index}
                    aria-label={`Open details: ${slide.title}`}
                >
                    <img
                        src={slide.image}
                        alt={slide.title}
                        width="1280"
                        height="720"
                        loading={index === 0 ? "eager" : "lazy"}
                        decoding="async"
                    />
                    {slide.views && <span class="views">{slide.views} views</span>}
                </button>
            ))}
        </div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-next"></div>
    </div>
</div>

<script>
    import Swiper from "swiper";
    import { Autoplay, EffectCreative, Keyboard, Navigation, Pagination } from "swiper/modules";

    const MAX_TILT_DEG = 6;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function updateGlow(glow: HTMLImageElement, swiper: Swiper) {
        const image = swiper.slides[swiper.activeIndex]?.querySelector("img");
        if (!image || glow.src === image.src) {
            return;
        }
        glow.src = image.src;
        glow.animate([{ opacity: 0 }, { opacity: 0.7 }], { duration: 700, easing: "ease-out" });
    }

    function trackTilt(frame: HTMLElement) {
        frame.addEventListener("pointermove", (event) => {
            const bounds = frame.getBoundingClientRect();
            frame.style.setProperty("--tilt-x", `${((event.clientY - bounds.top) / bounds.height - 0.5) * -MAX_TILT_DEG}deg`);
            frame.style.setProperty("--tilt-y", `${((event.clientX - bounds.left) / bounds.width - 0.5) * MAX_TILT_DEG}deg`);
        });
        frame.addEventListener("pointerleave", () => {
            frame.style.removeProperty("--tilt-x");
            frame.style.removeProperty("--tilt-y");
        });
    }

    document.querySelectorAll<HTMLElement>("[data-carousel-frame]").forEach((frame) => {
        const carousel = frame.querySelector<HTMLElement>(".carousel");
        const glow = frame.querySelector<HTMLImageElement>("[data-carousel-glow]");
        if (!carousel || !glow) {
            return;
        }
        new Swiper(carousel, {
            modules: [Autoplay, EffectCreative, Keyboard, Navigation, Pagination],
            rewind: true,
            speed: prefersReducedMotion ? 0 : 650,
            effect: "creative",
            creativeEffect: {
                prev: { shadow: true, translate: ["-25%", 0, -400], rotate: [0, 18, 0], opacity: 0 },
                next: { translate: ["100%", 0, 0] },
            },
            autoplay: { delay: 4000, pauseOnMouseEnter: true },
            keyboard: { onlyInViewport: true },
            navigation: {
                prevEl: carousel.querySelector<HTMLElement>(".swiper-button-prev"),
                nextEl: carousel.querySelector<HTMLElement>(".swiper-button-next"),
            },
            pagination: { el: carousel.querySelector<HTMLElement>(".swiper-pagination"), type: "fraction" },
            on: { slideChange: (swiper) => updateGlow(glow, swiper) },
        });
        if (!prefersReducedMotion) {
            trackTilt(frame);
        }
    });
</script>

<style>
    .carousel-frame {
        --glow-border: 3px;

        isolation: isolate;
        border-radius: 10px;
        transform: perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
        transition: transform 0.2s ease-out;
    }

    .carousel-frame:hover {
        transform: perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)) scale(1.03);
    }

    .carousel-glow {
        position: absolute;
        top: 10%;
        left: 5%;
        z-index: -1;
        width: 90%;
        height: 95%;
        object-fit: cover;
        filter: blur(26px) saturate(1.8);
        opacity: 0.7;
        pointer-events: none;
    }

    .carousel {
        --swiper-navigation-color: var(--text);
        --swiper-navigation-size: 1.6rem;
        --swiper-navigation-sides-offset: 0.5rem;

        border-radius: 10px;
        font-family: var(--font-body);
        font-weight: 600;
    }

    .swiper-slide {
        padding: 0;
        border: 0;
        background: var(--bg);
        cursor: zoom-in;
    }

    .carousel img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
    }

    .swiper-button-prev,
    .swiper-button-next {
        filter: drop-shadow(0 0 3px black);
    }

    .swiper-pagination {
        top: 0.4rem;
        right: 0.4rem;
        bottom: auto;
        left: auto;
        width: auto;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: rgb(0 0 0 / 0.75);
        color: var(--text);
        font-size: 0.8rem;
    }

    .views {
        position: absolute;
        right: 0.4rem;
        bottom: 0.4rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: rgb(0 0 0 / 0.75);
        color: var(--text);
        font-size: 0.8rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .carousel-frame,
        .carousel-frame:hover {
            transform: none;
        }
    }
</style>
