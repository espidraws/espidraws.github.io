---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/url";

interface Props {
    site: CollectionEntry<"site">["data"]["content"];
}

const { site } = Astro.props;
---

<nav class="top-nav">
    <a href="#thumbnails">Commission pricing</a>
    <a href="#reviews">Client reviews</a>
</nav>

<header class="hero">
    <img class="avatar" src={withBase(site.avatar)} alt="" width="400" height="400" />
    <div>
        <div class="name-row">
            <h1>{site.name}</h1>
            {site.socials.map((social) => (
                <a class="social" href={social.url} aria-label={social.label} target="_blank" rel="noopener">
                    {social.label}
                </a>
            ))}
        </div>
        <p class="tagline">{site.tagline}</p>
        <ul class="buttons">
            {site.buttons.map((button) => (
                <li>
                    <a class:list={["button", button.color]} href={button.url} target="_blank" rel="noopener">
                        {button.label}
                    </a>
                </li>
            ))}
        </ul>
    </div>
</header>

<style>
    .top-nav {
        display: flex;
        gap: 1.5rem;
        padding-block: 1rem;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .hero {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1.5rem 2rem;
        padding-block: 1rem 0.5rem;
    }

    .avatar {
        width: clamp(120px, 20vw, 170px);
        border-radius: 50%;
    }

    .name-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    h1 {
        margin: 0;
        font-size: clamp(2.2rem, 6vw, 3.5rem);
        font-weight: 900;
    }

    .social {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 6px;
        background: var(--text);
        color: var(--bg);
        font-weight: 900;
        text-decoration: none;
    }

    .tagline {
        margin: 0.25rem 0 0.75rem;
        font-style: italic;
        font-weight: 900;
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .button {
        display: inline-block;
        padding: 0.55rem 1.6rem 0.55rem 1rem;
        clip-path: polygon(0 0, calc(100% - 0.9rem) 0, 100% 50%, calc(100% - 0.9rem) 100%, 0 100%);
        color: white;
        font-family: var(--font-body);
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        text-transform: uppercase;
        transition: filter 0.15s;
    }

    .button:hover,
    .button:focus-visible {
        filter: brightness(1.15);
    }

    .blue {
        background: var(--blue);
    }

    .red {
        background: var(--red);
    }

    .green {
        background: var(--button-green);
    }
</style>
