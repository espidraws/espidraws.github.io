---
import { getEntry } from "astro:content";
import ContactBar from "../components/ContactBar.astro";
import Hero from "../components/Hero.astro";
import OcDesigns from "../components/OcDesigns.astro";
import Reviews from "../components/Reviews.astro";
import ThumbnailTiers from "../components/ThumbnailTiers.astro";
import TotalViews from "../components/TotalViews.astro";
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/url";
import { formatCount, loadYouTubeStats } from "../lib/youtube";

const site = (await getEntry("site", "main"))?.data.content;
const ocDesigns = (await getEntry("ocDesigns", "main"))?.data.content;
const tiers = (await getEntry("thumbnails", "main"))?.data.content.tiers;
const reviews = (await getEntry("reviews", "main"))?.data.content.reviews;
if (!site || !ocDesigns || !tiers || !reviews) {
    throw new Error("A content file in src/content is missing");
}

const thumbnails = tiers.flatMap((tier) => tier.items);
const stats = await loadYouTubeStats(
    reviews.map((review) => review.channel),
    thumbnails.map((thumbnail) => thumbnail.video),
);

const reviewsByChannelId = new Map(
    reviews.flatMap((review) => {
        const channelId = stats.getChannel(review.channel)?.id;
        return channelId ? [[channelId, review] as const] : [];
    }),
);

const tiersWithVideoInfo = tiers.map((tier) => ({
    ...tier,
    items: tier.items.map((thumbnail) => {
        const video = stats.getVideo(thumbnail.video);
        const channel = video ? stats.getChannel(video.channelId) : undefined;
        const review = video ? reviewsByChannelId.get(video.channelId) : undefined;
        return {
            title: video?.title ?? thumbnail.title,
            image: withBase(thumbnail.image),
            videoUrl: thumbnail.video || undefined,
            views: video ? formatCount(video.views) : undefined,
            likes: video?.likes === undefined ? undefined : formatCount(video.likes),
            channelName: channel?.title,
            channelAvatar: channel?.avatar,
            review: review ? { name: review.name, quote: review.quote } : undefined,
        };
    }),
}));

const reviewsWithLiveSubscribers = reviews.map((review) => {
    const subscribers = stats.getChannel(review.channel)?.subscribers;
    return { ...review, subscribers: subscribers === undefined ? review.subscribers : formatCount(subscribers) };
});
---

<Layout
    title={`${site.name} | Thumbnail Artist`}
    description={`${site.name}: ${site.tagline}. Thumbnail commissions, OC designs and client reviews.`}
    image={site.avatar}
>
    <main>
        <Hero site={site} />
        <ThumbnailTiers copy={site.thumbnails} tiers={tiersWithVideoInfo} />
        {stats.totalViews > 0 && <TotalViews copy={site.totalViews} total={formatCount(stats.totalViews)} />}
        <OcDesigns designs={ocDesigns} />
        <Reviews reviews={reviewsWithLiveSubscribers} />
    </main>
    <ContactBar contactUrl={site.contactUrl} />
</Layout>
